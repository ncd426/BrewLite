generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                 Int                @id @default(autoincrement())
  name               String
  category           String?
  description        String?
  price              Int
  imageUrl           String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  orderItems         OrderItem[]
  productIngredients ProductIngredient[]
}

model Ingredient {
  id                 Int                @id @default(autoincrement())
  code               String             @unique
  name               String             @unique
  unit               String
  stockQuantity      Int                @default(0)
  minStock           Int                @default(0)
  importPrice        Int?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  productIngredients ProductIngredient[]
}

model ProductIngredient {
  id           Int        @id @default(autoincrement())
  productId    Int
  ingredientId Int
  quantity     Int
  isOptional   Boolean    @default(false)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([productId, ingredientId])
  @@index([ingredientId])
}

model User {
  id            Int      @id @default(autoincrement())
  name          String   @default("")
  email         String   @unique
  passwordHash  String
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]
}

model Order {
  id        Int         @id @default(autoincrement())
  userId    Int
  status    OrderStatus @default(PENDING)
  total     Int
  discountAmount Int @default(0)
  promotionId Int?
  loyaltyAwardedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id])
  items     OrderItem[]
  payments  Payment[]
  promotion Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int
  size      String
  qty       Int
  lineTotal Int
  unitPrice Int?
  toppings Json?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}

model Payment {
  id             Int          @id @default(autoincrement())
  orderId        Int
  idempotencyKey String       @unique
  amount         Int
  pointsUsed     Int          @default(0)
  method         String
  status         PaymentStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  order          Order        @relation(fields: [orderId], references: [id])
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  PAYMENT_FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

// A small promotion table supports the discount-code requirement in Task 10.
// FIXED.value is in VND; PERCENT.value is an integer percentage (0..100).
// Validate ranges and expiry in NestJS services.
model Promotion {
  id Int @id @default(autoincrement())
  code String @unique
  type DiscountType
  value Int
  minOrderTotal Int @default(0)
  startsAt DateTime?
  expiresAt DateTime?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  orders Order[]
}

enum DiscountType {
  FIXED
  PERCENT
}
