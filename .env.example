# Local Docker Compose settings. Change these before using any non-local environment.
POSTGRES_DB=brewlite
POSTGRES_USER=postgres
POSTGRES_PASSWORD=brewlite-local-only
POSTGRES_PORT=5433

# Demo account password is used only when the seed creates an account.
SEED_DEMO_PASSWORD=replace-with-local-demo-password
JWT_SECRET=replace-with-a-long-local-only-secret

# Host-facing URLs. Compose overrides DATABASE_URL internally to connect to db.
DATABASE_URL=postgresql://postgres:brewlite-local-only@localhost:5433/brewlite
NEXT_PUBLIC_API_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3000
